{
  "name": "js-prueffactory",
  "version": "0.0.0",
  "private": true,
  "description": "Checks a JavaScript project in Docker and writes a Report.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "js-prueffactory": "bin/js-prueffactory.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'bin/**/!(*.docker).test.ts' 'cmd/**/!(*.docker).test.ts' 'dev/**/!(*.docker).test.ts' 'internal/**/!(*.docker).test.ts'",
    "test:docker": "node --test --test-timeout=3600000 'bin/**/*.docker.test.ts' 'cmd/**/*.docker.test.ts' 'dev/**/*.docker.test.ts' 'internal/**/*.docker.test.ts'",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "parity": "node dev/parity/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
